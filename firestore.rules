rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Quick sessions: sessions/{uid} belongs to whoever is signed in as that uid (an anonymous
    // visitor, or a real account). Old club logins (fake emails) own nothing.
    function isClub(sessionId) {
      return request.auth != null && request.auth.uid == sessionId;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isClub(sessionId);

      // Everything under a quick session is public to read, except leftover bookingRequests.
      match /{coll}/{docId} {
        allow read: if coll != 'bookingRequests' || isClub(sessionId);
        allow write: if isClub(sessionId);
      }
    }

    // ---- A real person: signed in with email or Google. Not an anonymous quick-session visitor,
    // and not an old club login (fake @courtflow.local email).
    function isRealUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !request.auth.token.get('email', '').lower().matches('.*@courtflow[.]local');
    }

    // ---- Accounts: the person's own profile and their "My clubs" copies. Nobody else, ever.
    match /accounts/{uid} {
      allow read, write: if isRealUser() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if isRealUser() && request.auth.uid == uid;
      }
    }

    // A manager writes a new member's card when approving them (create, or replace a stale one left from an
    // earlier stay) and deletes it when removing the member, only in the same batch as the member-record
    // change (exists / getAfter / existsAfter). Nothing else of another person's account is reachable.
    // (Everything of your own is covered by the rule above.)
    match /accounts/{uid}/memberships/{clubId} {
      allow create, update: if isManager(clubId)
        && request.resource.data.role == 'member'
        && request.resource.data.keys().hasOnly(['clubName', 'role', 'joinedAt'])
        && request.resource.data.keys().hasAll(['clubName', 'role', 'joinedAt'])
        && validName(request.resource.data.clubName)
        && request.resource.data.joinedAt is number
        && !exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(uid))
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(uid)).data.role == 'member';
      // The owner changes a member's role (member / manager) in the same batch as the member record:
      // the card may only change its role, to the role the member record ends up with.
      allow update: if isOwner(clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['member', 'manager']
        && exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(uid))
        && getAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(uid)).data.role == request.resource.data.role;
      allow delete: if isManager(clubId)
        && uid != get(clubPath(clubId)).data.ownerId
        && !existsAfter(/databases/$(database)/documents/clubs/$(clubId)/members/$(uid));
    }

    // ---- Friends. A small public directory (names only, never an email) and the friendships between two people.
    // profiles: only while "find me by name" is on, searched by a name prefix (at most 20 results, always with a limit).
    // friendCodes: one lookup at a time (get, never a list). friendships/{a_b}: the two uids sorted; the sender asks,
    // only the other person accepts, either removes.
    function validFriendCode(c) { return c.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{8}$'); }
    match /profiles/{uid} {
      allow get: if isRealUser();
      allow list: if isRealUser() && request.query.limit <= 20;
      allow create, update: if isRealUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'nameLower'])
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.trim().lower();
      allow delete: if isRealUser() && request.auth.uid == uid;
    }
    match /friendCodes/{code} {
      allow get: if isRealUser();
      allow create: if isRealUser() && validFriendCode(code)
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid && validName(request.resource.data.name);
      allow update: if isRealUser() && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid && validName(request.resource.data.name);
      allow delete: if isRealUser() && resource.data.uid == request.auth.uid;
    }
    match /friendships/{pair} {
      allow get, list: if isRealUser() && request.auth.uid in resource.data.users;
      allow create: if isRealUser()
        && request.resource.data.keys().hasOnly(['users', 'names', 'status', 'requestedBy', 'createdAt'])
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && pair == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.names.keys().hasOnly(request.resource.data.users)
        && request.resource.data.names.keys().hasAll(request.resource.data.users)
        && validName(request.resource.data.names[request.resource.data.users[0]])
        && validName(request.resource.data.names[request.resource.data.users[1]])
        && nearNow(request.resource.data.createdAt);
      // The other person accepts (status only); either person may refresh their own name in `names`.
      allow update: if isRealUser() && request.auth.uid in resource.data.users
        && ((resource.data.status == 'pending' && request.auth.uid != resource.data.requestedBy
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'accepted')
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
              && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
              && validName(request.resource.data.names[request.auth.uid])));
      allow delete: if isRealUser() && request.auth.uid in resource.data.users;
    }

    // ---- Chats. A club's group chat is club_{clubId}: every member reads and writes it, a manager starts it and
    // moderates it. (Direct messages are added by the next plan.) Access follows the club's member record on every request.
    function chatClub(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)).data.clubId; }
    function validTail(d) {
      return d.lastText is string && d.lastText.size() <= 100 && d.lastBy == request.auth.uid && nearNow(d.lastAt);
    }
    match /chats/{chatId} {
      // A member may "get" a club chat that doesn't exist yet: a refused read ends a listener for good, so without this
      // a member's open Inbox would never see the chat a manager starts later. (Nothing is revealed: it just isn't there.)
      allow get: if isRealUser() && (resource == null
        ? chatId.matches('club_.+') && isMember(chatId.replace('club_', ''))
        : resource.data.kind == 'club' && isMember(resource.data.clubId));
      allow list: if isRealUser() && resource.data.kind == 'club' && isMember(resource.data.clubId);
      allow create: if isRealUser() && request.resource.data.kind == 'club'
        && request.resource.data.keys().hasOnly(['kind', 'clubId', 'title', 'lastText', 'lastAt', 'lastBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['kind', 'clubId', 'title', 'lastText', 'lastAt', 'lastBy', 'createdAt'])
        && chatId == 'club_' + request.resource.data.clubId
        && isManager(request.resource.data.clubId)
        && validName(request.resource.data.title)
        && request.resource.data.lastText == '' && request.resource.data.lastAt == 0 && request.resource.data.lastBy == ''
        && nearNow(request.resource.data.createdAt);
      allow update: if isRealUser() && resource.data.kind == 'club' && isMember(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt', 'lastBy'])
        && validTail(request.resource.data);
      allow delete: if isRealUser() && resource.data.kind == 'club' && isOwner(resource.data.clubId);

      match /messages/{id} {
        allow read: if isRealUser() && isMember(chatClub(chatId));
        allow create: if isRealUser() && isMember(chatClub(chatId))
          && request.resource.data.keys().hasOnly(['from', 'name', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['from', 'name', 'text', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && validName(request.resource.data.name)
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && nearNow(request.resource.data.createdAt);
        allow delete: if isRealUser() && isMember(chatClub(chatId))
          && (resource.data.from == request.auth.uid || isManager(chatClub(chatId)));
      }
    }

    // ---- Clubs. The member record is the single source of truth for who may do what.
    function clubPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId);
    }
    function memberPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }
    function isMember(clubId) {
      return isRealUser() && exists(memberPath(clubId));
    }
    function memberRole(clubId) {
      return get(memberPath(clubId)).data.role;
    }
    function isManager(clubId) {
      return isMember(clubId) && memberRole(clubId) in ['owner', 'manager'];
    }
    function isOwner(clubId) {
      return isMember(clubId) && memberRole(clubId) == 'owner';
    }
    function isPublicClub(clubId) {
      return exists(clubPath(clubId)) && get(clubPath(clubId)).data.visibility == 'public';
    }
    // Public clubs show their open play to everyone; private clubs only to their members.
    function canSeeClub(clubId) {
      return isPublicClub(clubId) || isMember(clubId);
    }

    function invitePath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/private/invite;
    }
    function managerInvitePath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/private/managerInvite;
    }
    function joinRequestPath(clubId, uid) {
      return /databases/$(database)/documents/clubs/$(clubId)/joinRequests/$(uid);
    }
    function nearNow(ms) {
      return ms is number && ms > request.time.toMillis() - 600000 && ms < request.time.toMillis() + 600000;
    }
    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 60;
    }

    // A person asks to join a public club (they are not signed in as a quick session, and are not a member yet).
    function validJoinRequest(clubId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'message', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'status', 'createdAt'])
        && validName(d.name)
        && (!('message' in d) || (d.message is string && d.message.size() <= 200))
        && d.status == 'pending'
        && nearNow(d.createdAt)
        && isPublicClub(clubId)
        && !exists(memberPath(clubId));
    }
    // Joining with the club's current invite code: the member link makes a member, the owner's manager link
    // makes a manager. The rules read the invite document even though the person cannot; resetting the code
    // stops every old link at once.
    function validInviteJoin(clubId, uid) {
      let d = request.resource.data;
      return request.auth.uid == uid
        && d.keys().hasOnly(['role', 'name', 'joinedAt', 'inviteCode'])
        && d.keys().hasAll(['role', 'name', 'joinedAt', 'inviteCode'])
        && validName(d.name)
        && nearNow(d.joinedAt)
        && ((d.role == 'member' && exists(invitePath(clubId)) && d.inviteCode == get(invitePath(clubId)).data.code)
          || (d.role == 'manager' && exists(managerInvitePath(clubId)) && d.inviteCode == get(managerInvitePath(clubId)).data.code));
    }
    // A manager approving a pending request: a plain member record, nothing else.
    function validApproval(clubId, uid) {
      let d = request.resource.data;
      return isManager(clubId)
        && d.keys().hasOnly(['role', 'name', 'joinedAt'])
        && d.keys().hasAll(['role', 'name', 'joinedAt'])
        && d.role == 'member'
        && validName(d.name)
        && d.joinedAt is number
        && exists(joinRequestPath(clubId, uid))
        && get(joinRequestPath(clubId, uid)).data.status == 'pending';
    }

    function validClub(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.visibility in ['public', 'private']
        && d.ownerId is string
        && (!('description' in d) || (d.description is string && d.description.size() <= 500))
        && (!('location' in d) || (d.location is string && d.location.size() <= 100));
    }

    // A player's request to join an event. Players may not be signed in (public clubs), so this is
    // the one thing the public may create: a pending request with these fields only, for an event
    // that exists. seatId is the public id of the player's spot (the request id stays secret, so
    // the phone number can't be reached from the public attendee list). createdAt sets the place in
    // line, so it must be near the real time.
    function validEventRequest(clubId, eventId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'contact', 'method', 'ref', 'seatId', 'status', 'createdAt', 'uid'])
        && d.keys().hasAll(['name', 'contact', 'method', 'seatId', 'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.contact is string && d.contact.size() > 0 && d.contact.size() <= 40
        && d.method in ['cash', 'online']
        && (!('ref' in d) || (d.ref is string && d.ref.size() <= 60))
        && (!('uid' in d) || (d.uid is string && isRealUser() && d.uid == request.auth.uid))
        && d.seatId is string && d.seatId.size() > 0 && d.seatId.size() <= 60
        && d.status == 'pending'
        && d.createdAt is number
        && d.createdAt > request.time.toMillis() - 600000
        && d.createdAt < request.time.toMillis() + 600000
        && exists(/databases/$(database)/documents/clubs/$(clubId)/events/$(eventId));
    }

    match /clubs/{clubId} {
      // Public clubs: anyone. Any club: a signed-in person who has its address (the random id),
      // so an invite link can show what the club is. Only public clubs can be listed.
      allow get: if resource.data.visibility == 'public' || isRealUser();
      allow list: if resource.data.visibility == 'public';

      allow create: if isRealUser() && request.resource.data.ownerId == request.auth.uid
        && validClub(request.resource.data);
      // Managers edit content and settings; only the owner changes visibility; the owner never changes.
      allow update: if isManager(clubId) && validClub(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && (request.resource.data.visibility == resource.data.visibility || isOwner(clubId));
      allow delete: if isOwner(clubId);

      match /members/{uid} {
        // Your own record (to learn your role, even when you have none), or any record if you're a member.
        allow get: if isRealUser() && (request.auth.uid == uid || isMember(clubId));
        allow list: if isMember(clubId);
        // Three ways in: the owner's record (same batch as the club, getAfter sees the new club), an invite
        // join with the current code, and a manager approving a pending request.
        allow create: if isRealUser() && (
          (request.auth.uid == uid
            && request.resource.data.role == 'owner'
            && request.resource.data.keys().hasOnly(['role', 'name', 'joinedAt'])
            && getAfter(clubPath(clubId)).data.ownerId == request.auth.uid)
          || validInviteJoin(clubId, uid)
          || validApproval(clubId, uid));
        // The owner changes a role between member and manager (never the owner's own, never to owner).
        allow update: if isOwner(clubId) && request.auth.uid != uid
          && resource.data.role in ['member', 'manager']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['member', 'manager'];
        // Four ways out: the owner removes anyone else, a manager removes plain members, a member
        // leaves (the owner can't), and anyone's own record once the club is gone.
        allow delete: if isRealUser() && (
          (isOwner(clubId) && request.auth.uid != uid)
          || (isManager(clubId) && request.auth.uid != uid && resource.data.role == 'member')
          || (request.auth.uid == uid && resource.data.role != 'owner')
          || (request.auth.uid == uid && !exists(clubPath(clubId))));
      }

      match /events/{eventId} {
        allow read: if canSeeClub(clubId);
        allow write: if isManager(clubId);

        match /requests/{requestId} {
          // The request id is a random UUID the player keeps, so a single get works as "my booking"
          // without exposing anyone else's request. Phone numbers: no public list.
          allow get: if canSeeClub(clubId);
          allow list: if isManager(clubId);
          allow create: if validEventRequest(clubId, eventId) && (isPublicClub(clubId) || isMember(clubId));
          allow update, delete: if isManager(clubId);
        }

        // Game data (players, courts, matchLog, costs): managers write it all. Club members also read the players
        // and courts, which is the queue ("Your active session" on Home); those documents carry names, skill,
        // gender, results and the linked account id (uid). The match log and costs stay managers-only.
        match /{sub}/{docId} {
          allow write: if isManager(clubId);
          allow read: if isManager(clubId) || (sub in ['players', 'courts'] && isMember(clubId));
        }
      }

      match /roster/{id} {
        allow read: if isMember(clubId);
        allow write: if isManager(clubId);
      }
      // One request per person per club (the id is their uid). The requester sees only their own;
      // managers see all, decline (status only) and clear them. The requester withdraws or dismisses.
      match /joinRequests/{reqUid} {
        allow get: if isRealUser() && (request.auth.uid == reqUid || isManager(clubId));
        allow list: if isManager(clubId);
        allow create: if isRealUser() && request.auth.uid == reqUid && validJoinRequest(clubId);
        allow update: if isManager(clubId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'declined';
        allow delete: if isRealUser() && (request.auth.uid == reqUid || isManager(clubId));
      }
      // The invite codes: 8 characters, nothing else on the document. The member link is the managers';
      // the manager link (it makes managers) is the owner's alone.
      // (One wildcard match, so the owner can still list the folder when deleting the club.)
      match /private/{id} {
        allow read, delete: if isOwner(clubId) || (id == 'invite' && isManager(clubId));
        allow create, update: if (id == 'managerInvite' ? isOwner(clubId) : (id == 'invite' && isManager(clubId)))
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string && request.resource.data.code.size() == 8;
      }
    }
  }
}

{
  "name": "courtflow-react-firebase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project rules-test \"node tests/rules.test.mjs && node tests/cascade.test.mjs && node tests/membership.test.mjs && node tests/friends.test.mjs && node tests/chat.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-courtflow",
    "dev:emu": "vite --mode emulator --port 5300"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.4"
  }
}

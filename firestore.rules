rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A quick session lives at sessions/{uid}: whoever is signed in as that uid (an
    // anonymous visitor, or a real account) owns it. Old club logins (fake emails)
    // no longer own anything; those clubs are simply not reachable any more.
    function isClub(sessionId) {
      return request.auth != null && request.auth.uid == sessionId;
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isClub(sessionId);

      // Everything under a quick session is public to read, except leftover bookingRequests.
      match /{coll}/{docId} {
        allow read: if coll != 'bookingRequests' || isClub(sessionId);
        allow write: if isClub(sessionId);
      }
    }

    // Accounts: everything under accounts/{uid} belongs to that signed-in user.
    // Legacy club logins (fake @courtflow.local emails) are never account owners.
    function isAccountOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !request.auth.token.get('email', '').lower().matches('.*@courtflow[.]local');
    }

    // A player's request to join an event. Players aren't signed in, so this is the one
    // thing the public may create: a pending request with these fields only, for an event
    // that exists. seatId is the public id of the player's spot on the event (the request
    // id stays secret, so the phone number can't be reached from the public attendee list).
    // createdAt sets the place in line, so it must be near the real time. Only the host can
    // list, change or delete requests.
    function validEventRequest(uid, eventId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'contact', 'method', 'ref', 'seatId', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'contact', 'method', 'seatId', 'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.contact is string && d.contact.size() > 0 && d.contact.size() <= 40
        && d.method in ['cash', 'online']
        && (!('ref' in d) || (d.ref is string && d.ref.size() <= 60))
        && d.seatId is string && d.seatId.size() > 0 && d.seatId.size() <= 60
        && d.status == 'pending'
        && d.createdAt is number
        && d.createdAt > request.time.toMillis() - 600000
        && d.createdAt < request.time.toMillis() + 600000
        && exists(/databases/$(database)/documents/accounts/$(uid)/events/$(eventId));
    }

    match /accounts/{uid} {
      allow read, write: if isAccountOwner(uid);
      match /{document=**} {
        allow read, write: if isAccountOwner(uid);
      }

      // Events are public to read (the booking page lists them); only the host writes.
      // Rules are additive, so the owner-only block above still grants the host everything.
      match /events/{eventId} {
        allow read: if true;

        // The request id is a random UUID the player keeps, so a single get works as
        // "my booking" without exposing anyone else's request. No public list.
        match /requests/{requestId} {
          allow get: if true;
          allow create: if validEventRequest(uid, eventId);
        }
      }
    }
  }
}
